# ── LLM ─────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...

# ── Embeddings ───────────────────────────────────────────────────────────────
# Options: hash (dev, no API key), openai, fastembed
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=sk-...        # defaults to LLM_API_KEY if not set

# ── Qdrant vector database ───────────────────────────────────────────────────
# Leave empty to use local on-disk storage (backend/data/qdrant/)
QDRANT_URL=
QDRANT_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for local dev):
DATABASE_URL=sqlite:///./backend/data/syntera.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://syntera:password@localhost:5432/syntera

# ── Repository ingestion ─────────────────────────────────────────────────────
MAX_REPOSITORY_SIZE_BYTES=83886080
CLONE_TIMEOUT_SECONDS=120
PARSE_CONCURRENCY=4

# ── Retrieval tuning ─────────────────────────────────────────────────────────
TOP_K=20
SPARSE_TOP_K=20
SYMBOL_TOP_K=20
RERANK_TOP_K=12
GRAPH_EXPANSION_DEPTH=2
GRAPH_EXPANSION_LIMIT=24
MAX_CONTEXT_CHARS=24000

# ── Security ─────────────────────────────────────────────────────────────────
# Set to true only for debugging — exposes configuration files
ALLOW_CONFIG_INSPECT=false

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
